<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{% block title %}File Tools{% endblock %}</title>
<link rel="stylesheet" href="/static/style.css" />
</head>
<body class="min-h-screen bg-bg font-sans text-fg">
  <div class="mx-auto flex min-h-screen max-w-6xl flex-col gap-6 px-4 py-6 md:flex-row md:gap-10 md:py-10">

    <aside class="md:w-60 md:shrink-0">
      <div class="mb-6 px-3 text-lg font-bold">File Tools</div>
      {% include "partials/menu.njk" %}
    </aside>

    <main class="min-w-0 flex-1">
      <div class="max-w-3xl rounded-2xl border border-line bg-card p-6 shadow-2xl md:p-9">
        {% block content %}{% endblock %}
      </div>
    </main>

  </div>
  {% block scripts %}{% endblock %}
</body>
</html>