{% extends "layouts/base.njk" %}

{% block title %}{{ title }} · File Tools{% endblock %}

{% block content %}
  <div class="mb-2 text-[11px] font-bold uppercase tracking-[0.14em] text-accent">PDF TOOL</div>
  <h1 class="mb-2 text-2xl font-bold md:text-3xl">Sao chép PDF có mật khẩu</h1>
  <p class="mb-7 text-sm leading-6 text-muted">Tạo bản sao PDF không còn mã hóa trong thư mục đích.</p>

  {% if errorMessage %}
    <div class="mb-5 rounded-lg border border-err/30 bg-err/10 px-4 py-3 text-sm text-err" role="alert">
      {{ errorMessage }}
    </div>
  {% endif %}

  <form id="pdfCopyForm" action="/copy-protected-pdf" method="post" enctype="multipart/form-data">
    <label for="pdfInput" class="flex cursor-pointer items-center justify-between gap-4 rounded-lg border border-line bg-panel px-4 py-4 transition hover:border-accent">
      <span class="text-sm font-semibold">Chọn file PDF có mật khẩu</span>
      <span id="pdfFileName" class="max-w-1/2 truncate text-right text-xs text-muted">Chưa chọn file</span>
    </label>
    <input id="pdfInput" class="sr-only" type="file" name="pdf" accept=".pdf,application/pdf" required />

    <div class="mt-5">
      <label class="mb-2 block text-xs text-muted" for="pdfPassword">Mật khẩu file PDF</label>
      <input id="pdfPassword" class="w-full rounded-lg border border-line bg-panel px-3 py-3 text-sm text-fg focus:border-accent focus:outline-none"
        type="password" name="password" required autocomplete="off" />
    </div>

    <div class="mt-5">
      <label class="mb-2 block text-xs text-muted" for="pdfOutputDir">Thư mục lưu bản sao PDF</label>
      <input id="pdfOutputDir" class="w-full rounded-lg border border-line bg-panel px-3 py-3 text-sm text-fg placeholder:text-muted focus:border-accent focus:outline-none"
        type="text" name="outputDir" placeholder="Để trống = output/pdf/copy" autocomplete="off" />
    </div>

    <button id="pdfSubmitBtn" type="submit" disabled
      class="mt-5 inline-flex w-full items-center justify-center rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-accent-ink transition hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-50">
      Sao chép nội dung PDF
    </button>
    <div id="pdfLoading" class="mt-4 hidden items-center gap-3 text-sm text-muted" role="status">
      <span class="size-4 animate-spin rounded-full border-2 border-line border-t-accent"></span>
      <span>Đang xử lý PDF, vui lòng chờ...</span>
    </div>
  </form>
{% endblock %}

{% block scripts %}
<script>
  const pdfInput = document.getElementById('pdfInput');
  const pdfFileName = document.getElementById('pdfFileName');
  const pdfCopyForm = document.getElementById('pdfCopyForm');
  const pdfSubmitBtn = document.getElementById('pdfSubmitBtn');
  const pdfLoading = document.getElementById('pdfLoading');

  pdfInput.addEventListener('change', () => {
    const file = pdfInput.files[0];
    pdfFileName.textContent = file ? file.name : 'Chưa chọn file';
    pdfSubmitBtn.disabled = !file;
  });

  pdfCopyForm.addEventListener('submit', () => {
    pdfSubmitBtn.disabled = true;
    pdfSubmitBtn.textContent = 'Đang sao chép...';
    pdfLoading.classList.replace('hidden', 'flex');
  });
</script>
{% endblock %}
