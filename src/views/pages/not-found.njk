 
{% extends "layouts/base.njk" %}

{% block title %}404 · Page Not Found · File Tools{% endblock %}

{% block content %}
<div class="flex min-h-[60vh] flex-col items-center justify-center px-4 text-center">
  <div class="mb-4 rounded-2xl border border-line bg-panel px-5 py-3">
    <span class="text-5xl font-extrabold tracking-tight text-accent">404</span>
  </div>

  <div class="mb-2 text-[11px] font-bold uppercase tracking-[0.14em] text-accent">
    PAGE NOT FOUND
  </div>

  <h1 class="mb-3 text-2xl font-bold md:text-3xl">
    Không tìm thấy trang
  </h1>

  <p class="max-w-md text-sm leading-relaxed text-muted">
    Trang bạn đang tìm kiếm không tồn tại hoặc đã được di chuyển.
    Vui lòng kiểm tra lại đường dẫn và thử lại.
  </p>

  <a
    class="mt-6 inline-flex w-full max-w-xs items-center justify-center rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-white transition hover:opacity-90"
    href="/"
  >
    Quay về trang chủ
  </a>
</div>
{% endblock %}