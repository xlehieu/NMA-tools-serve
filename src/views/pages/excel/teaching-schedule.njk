{% extends "layouts/base.njk" %}

{% block title %}Lịch báo giảng · File Tools{% endblock %}

{% block content %}
  <h1 class="mb-2 text-2xl font-bold md:text-3xl">Cập nhật tiết PPCT</h1>
  <p class="mb-7 text-sm leading-6 text-muted">
    Đánh số tiết tuần mới từ tiết lớn nhất của tuần cũ cho từng môn và lớp.
    Hỗ trợ file .xlsx và .xls, tối đa 10 MB mỗi file.
  </p>

  {% if errorMessage %}
    <div class="mb-5 rounded-lg border border-err/30 bg-err/10 px-4 py-3 text-sm text-err" role="alert">
      {{ errorMessage }}
    </div>
  {% endif %}

  <div id="scheduleError" class="mb-5 rounded-lg border border-err/30 bg-err/10 px-4 py-3 text-sm text-err" role="alert" hidden></div>

  <form id="scheduleForm" action="/excel/teaching-schedule" method="post" enctype="multipart/form-data" class="grid gap-5">
    <label class="grid gap-2 text-sm font-semibold">
      File Excel tuần cũ
      <input class="w-full rounded-lg border border-line bg-panel p-3" type="file"
        name="previousWeek" accept=".xls,.xlsx" required />
    </label>
    <label class="grid gap-2 text-sm font-semibold">
      File Excel tuần mới
      <input class="w-full rounded-lg border border-line bg-panel p-3" type="file"
        name="currentWeek" accept=".xls,.xlsx" required />
    </label>
    <div id="subjectMappings" class="grid gap-3" hidden></div>
    <button type="submit" class="rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-accent-ink hover:bg-accent-hover">
      Cập nhật và tải Excel
    </button>
  </form>
{% endblock %}

{% block scripts %}
<script>
  const form = document.getElementById('scheduleForm');
  const errorBox = document.getElementById('scheduleError');
  const submit = form.querySelector('button[type="submit"]');
  const currentInput = form.elements.namedItem('currentWeek');
  const mappingBox = document.getElementById('subjectMappings');

  currentInput.addEventListener('change', async () => {
    mappingBox.replaceChildren();
    mappingBox.hidden = true;
    const file = currentInput.files[0];
    if (!file) return;
    const data = new FormData();
    data.append('currentWeek', file);
    try {
      const response = await fetch('/excel/teaching-schedule/subjects', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: data,
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.message || 'Không đọc được danh sách môn học.');
      result.subjects.forEach((subject) => {
        const label = document.createElement('label');
        const title = document.createElement('span');
        const select = document.createElement('select');
        label.className = 'grid gap-2 text-sm font-semibold';
        title.textContent = 'Đổi tên môn cho ' + subject;
        select.className = 'w-full rounded-lg border border-line bg-panel p-3';
        select.dataset.sourceSubject = subject;
        result.choices.forEach((choice) => {
          const option = document.createElement('option');
          option.value = choice;
          option.textContent = choice;
          option.selected = choice === subject;
          select.append(option);
        });
        label.append(title, select);
        mappingBox.append(label);
      });
      mappingBox.hidden = false;
    } catch (error) {
      errorBox.textContent = error.message;
      errorBox.hidden = false;
    }
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorBox.hidden = true;
    submit.disabled = true;
    try {
      const data = new FormData(form);
      const mappings = Object.fromEntries([...mappingBox.querySelectorAll('select')].map((select) => [select.dataset.sourceSubject, select.value]));
      data.set('subjectMappings', JSON.stringify(mappings));
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: data,
      });
      if (!response.ok) {
        const type = response.headers.get('content-type') || '';
        const message = type.includes('application/json') ? (await response.json()).message : null;
        throw new Error(typeof message === 'string' ? message : 'Không xử lý được lịch báo giảng.');
      }

      const file = form.elements.namedItem('currentWeek').files[0];
      const url = URL.createObjectURL(await response.blob());
      const link = document.createElement('a');
      link.href = url;
      link.download = file.name.replace(/(\.xlsx?)$/i, ' - PPCT$1');
      document.body.append(link);
      link.click();
      link.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    } catch (error) {
      errorBox.textContent = error.message;
      errorBox.hidden = false;
    } finally {
      submit.disabled = false;
    }
  });
</script>
{% endblock %}
