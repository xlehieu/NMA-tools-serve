<nav class="flex flex-col gap-6">
  {% for group in menu %}
  <div>
    <div class="mb-2 px-3 text-[11px] font-bold uppercase tracking-[0.14em] text-accent">{{ group.label }}</div>
    <ul class="flex flex-col gap-1">
      {% for item in group.children %}
      <li>
        <a href="{{ item.path }}"
           class="block rounded-lg px-3 py-2 text-sm font-semibold transition-colors {{ 'bg-panel text-accent' if item.active else 'text-muted hover:bg-panel hover:text-fg' }}">
          {{ item.label }}
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endfor %}
</nav>