{
  "name": "docx2pdf-nest",
  "version": "1.0.0",
  "description": "Tool cá nhân: convert hàng loạt file .docx sang .pdf bằng NestJS + LibreOffice",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn src/main.ts",
    "cli": "ts-node src/cli.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/schedule": "^12.0.2",
    "@types/multer": "^1.4.13",
    "@xmldom/xmldom": "^0.9.12",
    "jszip": "^3.10.2",
    "multer": "^1.4.5-lts.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
