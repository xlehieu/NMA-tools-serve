{
  "name": "docx2pdf-nest",
  "version": "1.0.0",
  "description": "Tool cá nhân: convert hàng loạt file .docx sang .pdf bằng NestJS + LibreOffice",
  "scripts": {
    "build": "npm run build:css && tsc -p tsconfig.json && npm run build:views",
    "start": "node dist/main.js",
    "start:dev": "concurrently -k \"npm:watch:css\" \"npm:watch:server\"",
    "build:css": "tailwindcss -i ./src/views/styles/input.css -o ./public/static/style.css",
    "build:views": "node -e \"require('node:fs').cpSync('src/views', 'dist/views', {recursive:true})\"",
    "watch:css": "npm run build:css -- --watch",
    "watch:server": "ts-node-dev --respawn src/main.ts",
    "cli": "ts-node src/cli.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@types/multer": "^1.4.13",
    "multer": "^1.4.5-lts.1",
    "nunjucks": "^3.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@tailwindcss/cli": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/nunjucks": "^3.2.6",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
